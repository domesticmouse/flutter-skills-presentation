[0.016, "o", "\u001b[?2026h\u001b[29A• \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk36db9856f16c6f3e;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_form_sheet.dart#L89-L93\u0007PartFormSheet.initState\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jk45e97d129ca38ec5;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/import_export_service.dart#L90\u0007ImportExportService.exportToCsv\u001b[m\u001b]8;;\u0007\n\u001b[67D\u001b[1mIssue\u001b[m: Passive components (resistors, MLCCs) often have sub-cent unit prices in bulk (e.g., \u001b[94m$0.0045\u001b[m). Formatting\r\n  with \u001b[94munitPrice.toStringAsFixed(2)\u001b[m truncates \u001b[94m$0.0045\u001b[m to \u001b[94m\"0.00\"\u001b[m when opening the edit form or exporting to CSV.\u001b[K\r\n\u001b[K\n  \u001b[1m#### C. Concurrent File Writes on Rapid Stock Adjustments\u001b[m\r\n\u001b[K\n  • \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jkcfc616213d13cb7f;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L162-L166\u0007PartsRepository._persist\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jk25d0"]
