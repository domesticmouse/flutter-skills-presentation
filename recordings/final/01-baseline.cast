[0.0, "o", "line/lib/data/services/local_storage_service.dart#L46-L78\u0007FileLocalStorageService.loadPartsJson\u001b[m\u001b]8;;\u0007 now throws a\r\n\u001b[6C\u001b[34;4m\u001b]8;id=jkdcc38a299da0de08;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L60-L63\u0007FormatException\u001b[m\u001b]8;;\u0007 when the storage file contains malformed JSON instead of returning \u001b[94mnull\u001b[m, preventing\u001b[K\n\u001b[99D\u001b[34;4m\u001b]8;id=jk8733597d7b43dc54;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L25-L38\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007 from overwriting user data with sample parts.\u001b[K\n\u001b[70D• \u001b[1mCross-platform path fallback\u001b[m: \u001b[34;4m\u001b]8;id=jkcde7daefe5cbc3fa;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L22-L43\u0007FileLocalStorageService._resolveStorageFile\u001b[m\u001b]8;;\u0007 now checks both \u001b[94mHOME\u001b[m and\r\n\u001b[6C\u001b[94mUSERPROFILE\u001b[m (for Windows).\u001b[K\n\u001b[26D• \u001b[1mSerialized async writes\u001b[m"]
