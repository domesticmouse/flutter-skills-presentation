[0.017, "o", "\u001b[?2026h\u001b[29A\u001b[1m### Summary of Fixes\u001b[m\r\n\u001b[K\n  1. \u001b[1mStorage Safety & Serialized File Writes\u001b[m\r\n      • \u001b[1mPrevented destructive overwrite on corrupt files\u001b[m: \u001b[34;4m\u001b]8;id=jk1116006ee96c87b2;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L46-L78\u0007FileLocalStorageService.loadPartsJson\u001b[m\u001b]8;;\u0007 now throws a\r\n\u001b[6C\u001b[34;4m\u001b]8;id=jke0dd21d9f07cd233;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L60-L63\u0007FormatException\u001b[m\u001b]8;;\u0007 when the storage file contains malformed JSON instead of returning \u001b[94mnull\u001b[m, preventing\u001b[K\n\u001b[99D\u001b[34;4m\u001b]8;id=jke6ae58e8f52f925d;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L25-L38\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007 from overwriting user data with sample parts.\u001b[K\n\u001b[70D• \u001b[1mCross-platform path fallback\u001b[m: \u001b[34;4m\u001b]8;id=jk5e1668224eee93e1;file:///Users/brett/Demos/f"]
[0.0, "o", "lutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L22-L43\u0007FileLocalStorageService._resolveStorageFile\u001b[m\u001b]8;;\u0007 now checks both \u001b[94mHOME\u001b[m and\r\n\u001b[6C\u001b[94mUSERPROFILE\u001b[m (for Windows).\u001b[K\n\u001b[26D• \u001b[1mSerialized async writes\u001b[m: \u001b[34;4m\u001b]8;id=jk70d9f63b2017cb81;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L176-L185\u0007PartsRepository._persist\u001b[m\u001b]8;;\u0007 queues persistence operations on \u001b[94m_writeChain\u001b[m so rapid\r\n\u001b[6Cquantity adjustments do not cause overlapping file I/O.\u001b[K\r\n  2. \u001b[1mSub-Cent Unit Price Precision\u001b[m\u001b[K\r\n      • Added \u001b[34;4m\u001b]8;id=jkb6ad4d4b34a3b8c8;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/domain/models/electronic_part.dart#L53-L65\u0007ElectronicPart.formattedUnitPrice\u001b[m\u001b]8;;\u0007 to format prices with at least 2 decimal places while preserving up\r\n\u001b[6Cto 6 decimal places for sub-cent components (e.g., \u001b[94m$0.0045\u001b[m).\u001b[K\n\u001b[60D• Updated \u001b[34;4m\u001b]8;"]
[0.0, "o", "id=jk373224650b8324f6;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/import_export_service.dart#L90\u0007ImportExportService.exportToCsv\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk30c65027da999a58;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_form_sheet.dart#L90-L92\u0007PartFormSheet\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk40286e88e838d328;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_detail_screen.dart#L438-L440\u0007PartDetailScreen\u001b[m\u001b]8;;\u0007 to use \u001b[94mformattedUnitPrice\u001b[m.\r\n  3. \u001b[1mViewModel Caching, Location Filter Normalization & Import Counts\u001b[m\u001b[K\r\n      • \u001b[1mCached derived lists\u001b[m: \u001b[34;4m\u001b]8;id=jk7ef2e56fa39eea7a;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/view_models/inventory_view_model.dart#L48-L216\u0007InventoryViewModel\u001b[m\u001b]8;;\u0007 now caches \u001b[94mfilteredParts\u001b[m, \u001b[94mrestockParts\u001b[m, \u001b[94mdistinctLocationN"]
