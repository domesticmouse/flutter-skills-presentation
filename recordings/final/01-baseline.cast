[0.0, "o", "/lib/data/services/local_storage_service.dart#L85-L104\u0007InMemoryLocalStorageService\u001b[m\u001b]8;;\u0007 makes repository, view-model, and widget tests fast and\r\n  deterministic without external mocking libraries.\r\n  ──────\r\n  \u001b[1m### 2. High-Priority Bugs & Risks\u001b[m\r\n\n  \u001b[1m#### A. Fragile File Storage & Data Loss Risk on Load Failure\u001b[m\r\n\n  • \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk9994446938ca881;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L22-L42\u0007FileLocalStorageService._resolveStorageFile\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jk605562f25ca388f9;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L21-L34\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007\r\n  • \u001b[1mIssues\u001b[m:\n\u001b[5D1. \u001b[1mCross-platform path resolution\u001b[m: \u001b[94m_resolveStorageFile()\u001b[m checks \u001b[94mPlatform.environment['HOME']\u001b[m and appends\r\n\u001b[6C\u001b[94m/Documents\u001b[m. On \u001b[1mAndroid\u001b[m (where \u001b[94mHOME\u001b[m is unset) and \u001b[1mWindows\u001b[m (which"]
[0.0, "o", " uses \u001b[94mUSERPROFILE\u001b[m), this falls back to\r\n\u001b[6C\u001b[94mDirectory.systemTemp\u001b[m, which the OS can purge at any time. On \u001b[1mWeb\u001b[m, \u001b[94mdart:io\u001b[m throws \u001b[94mUnsupportedError\u001b[m. Consider\r\n\u001b[6Cusing \u001b[94mpath_provider\u001b[m (\u001b[94mgetApplicationDocumentsDirectory()\u001b[m).\n\u001b[57D2. \u001b[1mDestructive fallback on parse errors\u001b[m: \u001b[34;4m\u001b]8;id=jk2d4af2ab2f0bf6e4;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L45-L69\u0007FileLocalStorageService.loadPartsJson\u001b[m\u001b]8;;\u0007 catches all exceptions and\r\n\u001b[6Creturns \u001b[94mnull\u001b[m if the file is malformed. \u001b[34;4m\u001b]8;id=jkbc4c7de5e0f42125;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L27-L34\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007 treats \u001b[94mnull\u001b[m as \"first run\" and immediately\r\n\u001b[6Ccalls \u001b[94m_persist()\u001b[m with sample data, \u001b[1moverwriting the user's file\u001b[m rather than surfacing a read error or backing up\r\n\u001b[6Cthe corrupt file.\r\n\n\n  \u001b[1m#### B."]
