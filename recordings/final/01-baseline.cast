[0.05, "o", "\u001b[?2026h\r\u001b[29A      2. \u001b[1mDestructive fallback on parse errors\u001b[m: \u001b]8;id=jkebb00d3045cc7b34;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L45-L69\u001b\\\u001b[4;34;4mF\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mL\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4mS\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mS\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mv\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4mP\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mJ\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b]8;;\u001b\\ catches all exceptions and\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6Creturns \u001b[94mnull\u001b[m if the file is malformed. \u001b[34;4m\u001b]8;id=jk5f2226d6116af864;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L27-L34\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007 treats \u001b[94mnull\u001b[m as \"first "]
[0.001, "o", "run\" and immediately\r\n\u001b[6Ccalls \u001b[94m_persist()\u001b[m with sample data, \u001b[1moverwriting the user's file\u001b[m rather than surfacing a read error or backing up\r\n\u001b[6Cthe corrupt file.\r\n\n\n  \u001b[1m#### B. Sub-Cent Unit Price Precision Loss on Edit & CSV Export\u001b[m\r\n\n  • \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jkbf087f2098f57d4c;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_form_sheet.dart#L89-L93\u0007PartFormSheet.initState\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jkb6a218793f999d7f;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/import_export_service.dart#L90\u0007ImportExportService.exportToCsv\u001b[m\u001b]8;;\u0007\r\n  • \u001b[1mIssue\u001b[m: Passive components (resistors, MLCCs) often have sub-cent unit prices in bulk (e.g., \u001b[94m$0.0045\u001b[m). Formatting\r\n  with \u001b[94munitPrice.toStringAsFixed(2)\u001b[m truncates \u001b[94m$0.0045\u001b[m to \u001b[94m\"0.00\"\u001b[m when opening the edit form or exporting to CSV.\r\n\n  \u001b[1m#### C. Concurrent File Writes on Rapid Stock Adjustments\u001b[m\r\n\n  "]
