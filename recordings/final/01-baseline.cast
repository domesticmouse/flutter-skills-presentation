[0.0, "o", "3\u0007FormatException\u001b[m\u001b]8;;\u0007 when the storage file contains malformed JSON instead of returning \u001b[94mnull\u001b[m, preventing\u001b[K\n\u001b[99D\u001b[34;4m\u001b]8;id=jkcfeb2139c7088dda;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L25-L38\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007 from overwriting user data with sample parts.\u001b[K\n\u001b[70D• \u001b[1mCross-platform path fallback\u001b[m: \u001b[34;4m\u001b]8;id=jk5241d4e5b6021f98;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L22-L43\u0007FileLocalStorageService._resolveStorageFile\u001b[m\u001b]8;;\u0007 now checks both \u001b[94mHOME\u001b[m and\r\n\u001b[6C\u001b[94mUSERPROFILE\u001b[m (for Windows).\u001b[K\n\u001b[26D• \u001b[1mSerialized async writes\u001b[m: \u001b[34;4m\u001b]8;id=jkaf95794d1dcf66e;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L176-L185\u0007PartsRepository._persist\u001b[m\u001b]8;;\u0007 queues persistence operations on \u001b[94m_writeChain\u001b[m so rapid\r\n\u001b[6Cquantity adjustmen"]
[0.0, "o", "ts do not cause overlapping file I/O.\u001b[K\r\n  2. \u001b[1mSub-Cent Unit Price Precision\u001b[m\u001b[K\r\n      • Added \u001b[34;4m\u001b]8;id=jk963cb0316d70f1b1;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/domain/models/electronic_part.dart#L53-L65\u0007ElectronicPart.formattedUnitPrice\u001b[m\u001b]8;;\u0007 to format prices with at least 2 decimal places while preserving up\r\n\u001b[6Cto 6 decimal places for sub-cent components (e.g., \u001b[94m$0.0045\u001b[m).\u001b[K\n\u001b[60D• Updated \u001b[34;4m\u001b]8;id=jk6d73703a5aba0347;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/import_export_service.dart#L90\u0007ImportExportService.exportToCsv\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jkc7f4721c77675f49;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_form_sheet.dart#L90-L92\u0007PartFormSheet\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk830a758f1b9f82a3;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_detail_screen.dart#L438"]
[0.0, "o", "-L440\u0007PartDetailScreen\u001b[m\u001b]8;;\u0007 to use \u001b[94mformattedUnitPrice\u001b[m.\r\n  3. \u001b[1mViewModel Caching, Location Filter Normalization & Import Counts\u001b[m\u001b[K\r\n      • \u001b[1mCached derived lists\u001b[m: \u001b[34;4m\u001b]8;id=jkc64ec45ea37bd5e5;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/view_models/inventory_view_model.dart#L48-L216\u0007InventoryViewModel\u001b[m\u001b]8;;\u0007 now caches \u001b[94mfilteredParts\u001b[m, \u001b[94mrestockParts\u001b[m, \u001b[94mdistinctLocationNames\u001b[m, and\r\n\u001b[6C\u001b[94mlocationSummaries\u001b[m, invalidating only when underlying data or filters change.\u001b[K\n\u001b[76D• \u001b[1mFixed \u001b[94;22m'Unassigned'\u001b[39;1m location rename\u001b[m: [\u001b[94mInventoryViewModel.renameLocation\u001b[m](file:///Users/brett/Demos/flutter-\r\n\u001b[6Cparts-experiment/parts_trac\u001b[K\n\n\n\n\n\u001b[31D\u001b[?2026l"]
