[0.016, "o", "\u001b[?2026h\u001b[29A\u001b[1m#### A. Fragile File Storage & Data Loss Risk on Load Failure\u001b[m\r\n\u001b[K\n  • \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jk5dacac68c77c7670;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L22-L42\u0007FileLocalStorageService._resolveStorageFile\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jk7f1f57e7a3c11ba0;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L21-L34\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007\n\u001b[80D\u001b[1mIssues\u001b[m:\u001b[K\r\n      1. \u001b[1mCross-platform path resolution\u001b[m: \u001b[94m_resolveStorageFile()\u001b[m checks \u001b[94mPlatform.environment['HOME']\u001b[m and appends\r\n\u001b[6C\u001b[94m/Documents\u001b[m. On \u001b[1mAndroid\u001b[m (where \u001b[94mHOME\u001b[m is unset) and \u001b[1mWindows\u001b[m (which uses \u001b[94mUSERPROFILE\u001b[m), this falls back to\u001b[K\r\n\u001b[6C\u001b[94mDirectory.systemTemp\u001b[m, which the OS can purge at any time. On \u001b[1mWeb\u001b[m, \u001b[94mdart:io\u001b[m throws \u001b[94mUnsupportedError\u001b[m. Consider\r\n\u001b[6Cusing \u001b[94mpath_provider\u001b[m (\u001b[94mgetApplicationDoc"]
[0.0, "o", "umentsDirectory()\u001b[m).\u001b[K\n\u001b[57D2. \u001b[1mDestructive fallback on parse errors\u001b[m: \u001b[34;4m\u001b]8;id=jk9f2cf570b41d161f;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L45-L69\u0007FileLocalStorageService.loadPartsJson\u001b[m\u001b]8;;\u0007 catches all exceptions and\r\n\u001b[6Creturns \u001b[94mnull\u001b[m if the file is malformed. \u001b[34;4m\u001b]8;id=jkd2aeb2adc73dfc88;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L27-L34\u0007PartsRepository.getParts\u001b[m\u001b]8;;\u0007 treats \u001b[94mnull\u001b[m as \"first run\" and immediately\r\n\u001b[6Ccalls \u001b[94m_persist()\u001b[m with sample data, \u001b[1moverwriting the user's file\u001b[m rather than surfacing a read error or backing up\r\n\u001b[6Cthe corrupt file.\u001b[K\r\n\u001b[K\n\n  \u001b[1m#### B. Sub-Cent Unit Price Precision Loss on Edit & CSV Export\u001b[m\r\n\u001b[K\n  • \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jkc16596fea618f350;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_form_s"]
[0.0, "o", "heet.dart#L89-L93\u0007PartFormSheet.initState\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jka178f6f7f474a05b;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/import_export_service.dart#L90\u0007ImportExportService.exportToCsv\u001b[m\u001b]8;;\u0007\n\u001b[67D\u001b[1mIssue\u001b[m: Passive components (resistors, MLCCs) often have sub-cent unit prices in bulk (e.g., \u001b[94m$0.0045\u001b[m). Formatting\r\n  with \u001b[94munitPrice.toStringAsFixed(2)\u001b[m truncates \u001b[94m$0.0045\u001b[m to \u001b[94m\"0.00\"\u001b[m when opening the edit form or exporting to CSV.\u001b[K\r\n\u001b[K\n  \u001b[1m#### C. Concurrent File Writes on Rapid Stock Adjustments\u001b[m\r\n\u001b[K\n  • \u001b[1mLocation\u001b[m: \u001b[34;4m\u001b]8;id=jke69ec8003b758ad5;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/repositories/parts_repository.dart#L162-L166\u0007PartsRepository._persist\u001b[m\u001b]8;;\u0007 & \u001b[34;4m\u001b]8;id=jkc9f51489784240a6;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/data/services/local_storage_service.dart#L72-L81\u0007FileLocalStorageService.savePartsJson\u001b[m\u001b]8;"]
[0.0, "o", ";\u0007\n\u001b[74D\u001b[1mIssue\u001b[m: Rapidly tapping the \u001b[94m+\u001b[m / \u001b[94m-\u001b[m buttons on \u001b[34;4m\u001b]8;id=jk84cae0c3fcdf815d;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/parts_list_view.dart#L260-L263\u0007PartsListView\u001b[m\u001b]8;;\u0007 or \u001b[34;4m\u001b]8;id=jkd2601d215cb190e8;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_baseline/lib/ui/features/inventory/views/part_detail_screen.dart#L311-L355\u0007PartDetailScreen\u001b[m\u001b]8;;\u0007 triggers overlapping \u001b[94mfile.\u001b[m\r\n  \u001b[94mwriteAsString(..., flush: true)\u001b[m calls without serialization or debouncing, which can cause I/O race conditions or\r\n  corrupt writes.\u001b[K\r\n  •\u001b[K\n\n\n\b\u001b[?2026l"]
