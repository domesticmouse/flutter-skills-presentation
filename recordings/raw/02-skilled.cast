[2.801, "o", "\u001b[?2026h\u001b[0 q\u001b[J\u001b[31A  3. \u001b[1mSeam 3: \u001b[94;22mHttpLcscClient\u001b[39;1m Adapter (\u001b[94;22mLcscClient.fetchPart(String rawCode)\u001b[39;1m over \u001b[94;22mpackage:http/testing.dart\u001b[39;1m \u001b[94;22mMockClient\u001b[39;1m)\u001b[m\u001b[K\r\n\u001b[6C• \u001b[1mPublic interface\u001b[m: \u001b[94mHttpLcscClient.fetchPart(String rawCode)\u001b[m returning \u001b[94mLcscPartMetadata\u001b[m.\u001b[K\n\u001b[52D\u001b[94mCx\u001b[5b\u001b[m code normalization/validation, browser \u001b[94mUser-Agent\u001b[m headers, JSON\r\n\u001b[6Cfield mapping (\u001b[94mproductDescEn\u001b[m/\u001b[94mproductModel\u001b[m/\u001b[94mbrandNameEn\u001b[m/\u001b[94mcatalogName\u001b[m/\u001b[94mencapStandard\u001b[m/\u001b[94mpdfUrl\u001b[m/\u001b[94mparamVOList\u001b[m), HTML\u001b[K\r\n\u001b[6Ctag/entity stripping, \u001b[94m\"-\"\u001b[m placeholder filtering, and not-found/network error handling; misses live LCSC\r\n\u001b[6Cavailability and UI form binding.\r\n  4. \u001b[1mSeam 4: Workbench Widget UI (\u001b[94;22mWidgetTester\u001b[39;1m pumping \u001b[94;22mPartsTrackerApp\u001b[39;1m with \u001b[94;22mProviderScope\u001b[39;1m overrides for\u001b[m\r\n  \u001b[94mcatalogPersistenceProvider\u001b[39;1m and \u001b[94;22mlcscClientProvider\u001b[39;1m)\u001b[m\u001b[K\n\u001b[46D• \u001b[1mPublic interface\u001b[m"]
