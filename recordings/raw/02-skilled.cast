[0.016, "o", "\u001b[?2026h\u001b[29A\u001b[9C\u001b[38;5;70;1mspecs\"\u001b[38;5;252;22m: {\u001b[m\u001b[K\n\u001b[10D\u001b[38;5;252m  \u001b[38;5;70;1m\"Resistance\"\u001b[38;5;252;22m: \u001b[38;5;214m\"10kΩ\"\u001b[38;5;252m,\u001b[m\n\u001b[20D\u001b[38;5;70;1mTolerance\"\u001b[38;5;252;22m: \u001b[38;5;214m\"±1%\"\u001b[38;5;252m,\u001b[m\u001b[K\n\u001b[18D\u001b[38;5;70;1mPower(Watts)\"\u001b[38;5;252;22m: \u001b[38;5;214m\"100mW\"\u001b[m\n\u001b[25D\u001b[38;5;252m}\u001b[m\u001b[K\r\n\t\u001b[38;5;252m}\u001b[m\u001b[K\n\b\b\b\u001b[38;5;252m]\u001b[m\u001b[K\n\b\b\b\u001b[38;5;252m}\u001b[m\u001b[K\r\n\u001b[K\n  Key schema rules:\r\n\u001b[K\n  1. \u001b[1mTop-level keys\u001b[m: \u001b[94mschemaVersion\u001b[m (integer \u001b[94m1\u001b[m), \u001b[94mupdatedAt\u001b[m (ISO-8601 UTC timestamp updated on every write/export),\r\n  \u001b[94mcontainers\u001b[m (array of \u001b[1mContainer\u001b[m objects), and \u001b[94mparts\u001b[m (array of \u001b[1mPart\u001b[m objects) — using \u001b[94mcontainers\u001b[m rather than \u001b[94mlocations\u001b[m\r\n  to match \u001b[34;4m\u001b]8;id=jkd38be6d1e566237b;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_skilled/GLOSSARY.md\u0007GLOSSARY.md\u001b[m\u001b]8;;\u0007.\u001b[K\r\n  2. \u001b[1mIdentical live & backup format\u001b[m: The live \u001b[94mparts_catalog.json\u001b[m file and exported backup files use the exact same\r\n  JSON e"]
