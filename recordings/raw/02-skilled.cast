[0.000, "o", "d=jkb3c2e68ce5cf57da;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_skilled/lib/prototype_workbench.dart#L698-L716\u0007VariantASplitTabsDenseRows\u001b[m\u001b]8;;\u0007\n\u001b[70D• \u001b[1mLayout\u001b[m: Classic 2-tab bottom \u001b[94mNavigationBar\u001b[m (\u001b[1mParts\u001b[m | \u001b[1mStorage\u001b[m).\n\u001b[63D• \u001b[1mPrimary affordance\u001b[m: Sticky search bar + filter chips (\u001b[94mAll\u001b[m, \u001b[94mLow Stock\u001b[m, \u001b[94mUnassigned\u001b[m, \u001b[94mPassives\u001b[m, \u001b[94mICs & MCUs\u001b[m) above\r\n\u001b[6Ca dense single-line-per-part list where every row has an inline \u001b[94m[-1] Qty [+1]\u001b[m stepper pill and a prominent\r\n\u001b[6C\u001b[1mLocation badge\u001b[m (\u001b[94mSMD Binder #1 · Page 4 · Strip 2\u001b[m). Tapping a row opens the full Part Detail bottom sheet (with\r\n\u001b[6C\u001b[94m-10 /\u001b[m\r\n\n⣷  \u001b[90mGener\u001b[94mating\u001b[90m...\u001b[m\r\n\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────"]
