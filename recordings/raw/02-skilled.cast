[0.000, "o", "[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4m,\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4mh\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mm\u001b[m\u001b[4;34;4ma\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4mv\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4m,\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4md\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mO\u001b[m\u001b[4;34;4mS\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4mF\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4ms\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mx\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4m/\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mm\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mt\u001b[m\u001b]8;;\u001b\\** (\u001b[94mwayfinder:grilling\u001b[m).\u001b[K\r\n\u001b[?5W\u001b[J\n  Let's work through the decisions one at a time.\r\n  ──────\u001b[?7l\r\n\u001b[K  ❓ \u001b[1mQ1\u001b[m - \u001b[1mLive On-Device JSON File Location, iOS Files App Visibility, and Atomic Writes\u001b[m: Where should the live\u001b[?7h\u001b["]
[0.000, "o", "112G\r\n  catalog JSON file live on iOS, should it be visible in the iOS \u001b[1mFiles\u001b[m app (\"On My iPhone\"), and how should writes be\r\n  persisted?\r\n\n  1. \u001b[1mApplication Support (internal-only) + Explicit Export/Import\u001b[m: Store the live database in Application Support\r\n  (\u001b[94mgetApplicationSupportDirectory()/catalog.json\u001b[m), hidden from the user in the iOS Files app, and rely strictly on\r\n  explicit Share Sheet / File Picker actions for backup and restore.\r\n  2. \u001b[1mApplication Documents (\u001b[94;22mcatalog.json\u001b[39;1m) + \u001b[94;22mUIFileSharingEnabled\u001b[39;1m & \u001b[94;22mLSSupportsOpeningDocumentsInPlace\u001b[39;1m + Explicit\u001b[m\r\n  \u001b[1mExport/Import\u001b[m: Store the live database at \u001b[94mgetApplicationDocumentsDirectory()/parts_catalog.json\u001b[m with\r\n  \u001b[94mUIFileSharingEnabled\u001b[m and \u001b[94mLSSupportsOpeningDocumentsInPlace\u001b[m enabled in \u001b[34;4m\u001b]8;id=jke6d250a1c264789;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_skilled/ios/Runner/Info.plist\u0007Info.plist\u001b[m\u001b]8;;\u0007, so the folder appears under \u001b[1mOn My\u001b[m\r"]
[0.000, "o", "\n  \u001b[1miPhone › Parts Tracker\u001b[m in the iOS Files app and Finder, \u001b[3min addition\u001b[m to in-app \u001b[1mExport Backup\u001b[m (Share Sheet / Save to\r\n  Files with timestamped filename like \u001b[94mparts-catalog-YYYY-MM-DD.json\u001b[m) and \u001b[1mImport Backup\u001b[m (File Picker) actions.\r\n  3. \u001b[1mWrite durability\u001b[m: Write every mutation (including \u001b[94m-1\u001b[m/\u001b[94m+1\u001b[m stock adjustments) immediately via an atomic write-to-\r\n  temp-file + rename (\u001b[94mparts_catalog.json.tmp\u001b[m → \u001b[94mparts_catalog.json\u001b[m) serialized through an async write queue, keeping\r\n  the file formatted with 2-space indentation so it remains human-readable and diff-friendly.\u001b[?7l\r\n\n\u001b[K  ➡️ \u001b[1mYes — use Option 2 + Option 3\u001b[m: store the live database at \u001b[94mgetApplicationDocumentsDirectory()/parts_catalog.json\u001b[?7h\u001b[117G\u001b[m\r\n  with \u001b[94mUIFileSharingEnabled\u001b[m and \u001b[94mLSSupportsOpeningDocumentsInPlace\u001b[m enabled in \u001b[34;4m\u001b]8;id=jke6d260a1c26493c;file:///Users/brett/Demos/flutter-parts-experiment/parts_tracker_skilled/ios/Runner/Info.plist\u0007Info.p"]
[0.000, "o", "list\u001b[m\u001b]8;;\u0007, pair it with explicit in-app\r\n  Export (timestamped JSON via Share Sheet) and Import (File Picker) actions, and persist every mutation via\r\n  serialized atomic temp-file write + rename (\u001b[94mparts_catalog.json.tmp\u001b[m → \u001b[94mparts_catalog.json\u001b[m) with 2-space pretty-\r\n  printed JSON.\r\n\n\u001b[90m────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[34;1m> yes\u001b[m\r\n⣽  \u001b[90mWorking\u001b[94m...\u001b[m\r\n\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m────────────────────────────────"]
