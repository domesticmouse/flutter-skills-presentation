[0.000, "o", "search omnibox filters the catalog in real time using\u001b[K\u001b[m\r\n\u001b[4C\u001b[37m\u001b[1K \u001b[48;2;14;52;15m \u001b[32m   \u001b[39mmulti-token \u001b[38;2;151;198;123m`AND`\u001b[39m matching across all 10 **Part** fields (\u001b[38;2;151;198;123m`name`\u001b[39m, \u001b[38;2;151;198;123m`lcscCode`\u001b[39m, \u001b[38;2;151;198;123m`mpn`\u001b[39m, \u001b[38;2;151;198;123m`manufacturer`\u001b[39m,\u001b[K\u001b[m\r\n\u001b[4C\u001b[37m\u001b[1K \u001b[48;2;14;52;15m \u001b[32m   \u001b[38;2;151;198;123m`category`\u001b[39m, \u001b[38;2;151;198;123m`package`\u001b[39m, resolved \u001b[38;2;151;198;123m`Container.name`\u001b[39m, \u001b[38;2;151;198;123m`slot`\u001b[39m, \u001b[38;2;151;198;123m`notes`\u001b[39m, and \u001b[38;2;151;198;123m`specs`\u001b[39m keys and values). Search\u001b[K\u001b[m\r\n\u001b[4C\u001b[37m\u001b[1K \u001b[48;2;14;52;15m \u001b[32m   \u001b[39mnormalizes Unicode electrical symbols (\u001b[38;2;151;198;123m`µ`\u001b[39m/\u001b[38;2;151;198;123m`μ`\u001b[39m → \u001b[38;2;151;198;123m`u`\u001b[39m, \u001b[38;2;151;198;123m`Ω`\u001b[39m/\u001b[38;2;151;198;123m`ohm`\u001b[39m/\u001b[38;2;151;198;123m`ohms`\u001b[39m → \u001b[38;2;151;198;123m`r`\u001b[39m, stripping \u001b[38;2;151;198;123m`±`\u001b[39m) and equates\u001b[K\u001b[m\r\n\u001b[4C\u001b[37m\u001b[1K \u001b[48;2;14;52;15m \u001b[32m   \u001b["]
